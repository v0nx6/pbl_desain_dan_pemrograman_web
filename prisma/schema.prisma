// Prisma schema for the boutique app.
// Money is stored as whole rupiah integers. Every price that a customer sees
// is recomputed here on the server, never trusted from the browser.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Collection {
  BARU
  BATIK
  KEBAYA
  PRIYA
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_VERIFICATION
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  COD
}

enum BankName {
  BCA
  MANDIRI
  BNI
  BRI
}

enum FulfillmentType {
  PICKUP
  COURIER
}

enum PaymentStatus {
  UNPAID
  PROOF_UPLOADED
  VERIFIED
  REJECTED
}

enum TryOnStatus {
  PROCESSING
  DONE
  FAILED
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum ProductType {
  SINGLE
  COUPLE
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String
  passwordHash   String?
  firebaseUid    String?        @unique
  role           Role           @default(CUSTOMER)
  phone          String?
  addressLine    String?
  city           String?
  postalCode     String?
  mapUrl         String?
  addressNote    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessions       Session[]
  orders         Order[]
  tryOnJobs      TryOnJob[]
  financeEntries FinanceEntry[]
  reviews        Review[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Product {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  description    String
  material       String
  price          Int
  collections    Collection[]
  productType    ProductType      @default(SINGLE)
  bestSeller     Boolean          @default(false)
  isNew          Boolean          @default(false)
  tone           Int              @default(300)
  image          String?
  imageAlt       String?
  tryOnCategory  String           @default("upper_body")
  tryOnPhotoType String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  variants       ProductVariant[]
  orderItems     OrderItem[]
  tryOnJobs      TryOnJob[]
  reviews        Review[]

  @@index([active])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
}

model Order {
  id               String          @id @default(cuid())
  number           String          @unique
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           OrderStatus     @default(PENDING_PAYMENT)
  paymentMethod    PaymentMethod
  bankName         BankName?
  fulfillmentType  FulfillmentType @default(COURIER)
  paymentStatus    PaymentStatus   @default(UNPAID)
  subtotal         Int
  shippingCost     Int
  total            Int
  recipientName    String
  phone            String
  addressLine      String
  city             String
  postalCode       String
  note             String?
  paymentReference String
  proofPath        String?
  proofMime        String?
  proofName        String?
  proofUploadedAt  DateTime?
  adminNote        String?
  stockRestored    Boolean         @default(false)
  paidAt           DateTime?
  shippedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  size      String
  price     Int
  qty       Int
  lineTotal Int
  createdAt DateTime @default(now())

  @@index([orderId])
}

model FinanceEntry {
  id          String      @id @default(cuid())
  type        FinanceType
  category    String
  description String
  amount      Int
  occurredAt  DateTime
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([occurredAt])
  @@index([type])
}

model Review {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  photos    ReviewPhoto[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model ReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  path      String
  mime      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([reviewId])
}

model PasswordReset {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  tokenHash  String?   @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique
  image     String
  imageAlt  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TryOnJob {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId  String?
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  status     TryOnStatus @default(PROCESSING)
  provider   String      @default("fashn")
  photoPath  String?
  resultPath String?
  note       String?
  error      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([userId])
}
